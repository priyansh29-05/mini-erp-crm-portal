# .env.example
# This file provides a template for required environment variables.
# Do NOT commit your actual .env file. Copy this file to .env and fill in the real values.

# DATABASE_URL: The connection string for your PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Used by Prisma to connect and manage the database.
DATABASE_URL="postgresql://johndoe:mypassword@localhost:5432/mydb?schema=public"

# JWT_SECRET: A strong, random string used to sign and verify JSON Web Tokens (JWT) for authentication.
# Keep this very secret. If it's compromised, anyone can forge valid user tokens.
JWT_SECRET="your_super_secret_jwt_key_here"
